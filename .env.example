# Moonshot / Kimi API 密钥
# 请复制为 .env 后填写真实值
MOONSHOT_API_KEY=your-api-key-here

# 可选：API Base URL（默认 https://api.moonshot.cn/v1）
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# DeepSeek（用于阶段2与阶段3-分析的思考模式）
# 未配置 DEEPSEEK_API_KEY 时将自动回退到 Kimi
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=high

# 联网工具调试（默认关闭）
# 1/true/on/yes 表示开启，会打印每轮 tool_calls 参数与回填内容摘要
# KIMI_TOOL_DEBUG=1
# 调试日志每条最大字符数（120~10000，默认 800）
# KIMI_TOOL_DEBUG_MAX_CHARS=1200
